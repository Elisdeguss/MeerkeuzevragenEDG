<Window x:Class="MeerkeuzeUI.BewerkTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Test Manueel Bewerken" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="AfgerondeKnop" TargetType="Button">
            <Setter Property="Background" Value="#FF6A5C5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecundaireKnop" TargetType="Button">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroeneKnop" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F4F6F7" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titel -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Test Manueel Bewerken" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Verwijder vragen links of voeg vragen toe vanuit de rechterkant."
                           FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Filter voor beschikbare vragen -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Laad beschikbare vragen:" FontWeight="Bold"
                               Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="CboOnderwerp" Width="180" Padding="4" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CboMoeilijkheid" Width="140" Padding="4" Margin="0,0,10,0"/>
                    <Button x:Name="BtnLaadVragen"
                            Content="Laad Vragen"
                            Padding="10,6" FontWeight="Bold"
                            Style="{StaticResource SecundaireKnop}"
                            Click="BtnLaadVragen_Click"/>
                </StackPanel>
            </Border>

            <!-- Twee DataGrids naast elkaar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Links: huidige testvragen -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 Huidige testvragen"
                               FontWeight="Bold" Foreground="#2C3E50"
                               FontSize="13" Margin="0,0,0,8"/>

                    <DataGrid x:Name="DGTestvragen" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9F9F9"
                              MouseDoubleClick="DGTestvragen_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Onderwerp" Binding="{Binding Onderwerp}" Width="1*"/>
                            <DataGridTextColumn Header="Vraag" Binding="{Binding Inhoud}" Width="2.5*"/>
                            <DataGridTextColumn Header="Niveau" Binding="{Binding Moeilijkheidsgraad}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="BtnVerwijder" Grid.Row="2"
                            Content="✖ Verwijder geselecteerde"
                            Padding="10,8" Margin="0,10,0,0" FontWeight="Bold"
                            Style="{StaticResource AfgerondeKnop}"
                            Click="BtnVerwijder_Click"/>
                </Grid>

                <!-- Midden: pijltjes als visuele scheiding -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="←" FontSize="22" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <TextBlock Text="→" FontSize="22" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Rechts: beschikbare vragen -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📚 Beschikbare vragen"
                               FontWeight="Bold" Foreground="#2C3E50"
                               FontSize="13" Margin="0,0,0,8"/>

                    <DataGrid x:Name="DGBeschikbaar" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F9F9F9"
                              MouseDoubleClick="DGBeschikbaar_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Onderwerp" Binding="{Binding Onderwerp}" Width="1*"/>
                            <DataGridTextColumn Header="Vraag" Binding="{Binding Inhoud}" Width="2.5*"/>
                            <DataGridTextColumn Header="Niveau" Binding="{Binding Moeilijkheidsgraad}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="BtnVoegToe" Grid.Row="2"
                            Content="✔ Voeg toe aan test"
                            Padding="10,8" Margin="0,10,0,0" FontWeight="Bold"
                            Style="{StaticResource GroeneKnop}"
                            Click="BtnVoegToe_Click"/>
                </Grid>
            </Grid>

            <!-- Onderaan: Accepteren / Annuleren -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="BtnAnnuleren"
                        Content="Annuleren"
                        Padding="14,8" Margin="0,0,10,0" FontWeight="Bold"
                        Style="{StaticResource SecundaireKnop}"
                        Click="BtnAnnuleren_Click"/>
                <Button x:Name="BtnAccepteren"
                        Content="✔ Accepteren"
                        Padding="14,8" FontWeight="Bold"
                        Style="{StaticResource GroeneKnop}"
                        Click="BtnAccepteren_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
