<Window x:Class="MeerkeuzeUI.VragenBeheerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vragen Beheren" Height="650" Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="AfgerondeKnop" TargetType="Button">
            <Setter Property="Background" Value="#FF6A5C5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RodeKnop" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroeneKnop" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F4F6F7" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Vragen Beheren" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Voeg nieuwe vragen toe of deactiveer bestaande vragen."
                           FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1">

                <TabItem Header="Nieuwe vraag toevoegen">
                    <Border Background="#F4F6F7" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <TextBlock Text="Onderwerp:" FontWeight="Bold"
                                           Foreground="#34495E" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="CboOnderwerpBestaand"
                                              Grid.Column="0" Padding="6"
                                              SelectionChanged="CboOnderwerpBestaand_SelectionChanged" HorizontalAlignment="Left" Width="104"/>
                                    <TextBlock Grid.Column="1" Text="of nieuw:" 
                                               VerticalAlignment="Center" Margin="10,0" Foreground="#7F8C8D"/>

                                    <TextBox x:Name="TxtOnderwerpNieuw" Grid.Column="2" Padding="6"
                                             TextChanged="TxtOnderwerpNieuw_TextChanged"/>
                                </Grid>


                                <TextBlock Text="Moeilijkheidsgraad:" FontWeight="Bold"
                                           Foreground="#34495E" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboMoeilijkheid" Padding="6" Margin="0,0,0,15"/>


                                <TextBlock Text="Vraagtekst:" FontWeight="Bold"
                                           Foreground="#34495E" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtVraagInhoud" Padding="6" Margin="0,0,0,15"
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="70"/>


                                <TextBlock Text="Antwoordopties:" FontWeight="Bold"
                                           Foreground="#34495E" Margin="0,0,0,8"/>
                                <TextBlock Text="Duid aan welk antwoord correct is via de radioknop links."
                                           FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>


                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbCorrectA" Grid.Column="0"
                                                 GroupName="CorrectAntwoord"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="A)" FontWeight="Bold"
                                               Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtOptieA" Grid.Column="2" Padding="6"/>
                                </Grid>


                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbCorrectB" Grid.Column="0"
                                                 GroupName="CorrectAntwoord"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="B)" FontWeight="Bold"
                                               Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtOptieB" Grid.Column="2" Padding="6"/>
                                </Grid>


                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbCorrectC" Grid.Column="0"
                                                 GroupName="CorrectAntwoord"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="C)" FontWeight="Bold"
                                               Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtOptieC" Grid.Column="2" Padding="6"/>
                                </Grid>


                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbCorrectD" Grid.Column="0"
                                                 GroupName="CorrectAntwoord"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="D)" FontWeight="Bold"
                                               Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtOptieD" Grid.Column="2" Padding="6"/>
                                </Grid>


                                <Button x:Name="BtnSlaVraagOp"
                                        Content="✔ Vraag Opslaan"
                                        Padding="14,10" FontWeight="Bold" FontSize="14"
                                        Style="{StaticResource GroeneKnop}"
                                        Click="BtnSlaVraagOp_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>


                <TabItem Header="Vragen deactiveren">
                    <Border Background="#F4F6F7" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Filter op onderwerp:" FontWeight="Bold"
                                           Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="CboFilterOnderwerp" Width="200" Padding="6"
                                          SelectionChanged="CboFilterOnderwerp_SelectionChanged"/>
                            </StackPanel>


                            <DataGrid x:Name="DGActieveVragen" Grid.Row="1"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="White" RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      AlternatingRowBackground="#F9F9F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Onderwerp" Binding="{Binding Onderwerp}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Vraag" Binding="{Binding Inhoud}" Width="3*"/>

                                    <DataGridTextColumn Header="Is Actief" Binding="{Binding IsActief}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            
                            <Button x:Name="BtnDeactiveer" Grid.Row="2"
                                    Content="✖ Deactiveer geselecteerde vraag"
                                    Padding="14,10" Margin="0,15,0,0" FontWeight="Bold" FontSize="14"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource RodeKnop}"
                                    Click="BtnDeactiveer_Click"/>
                        </Grid>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
